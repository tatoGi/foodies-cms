@push('styles')
<style>
.folder-list {
    max-height: 220px;
    overflow-y: auto;
    display: grid;
    gap: 6px;
}

.folder-link {
    border: 1px solid var(--admin-border);
    border-radius: 10px;
    padding: 8px 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--admin-text);
}

.folder-link:hover {
    background: var(--admin-surface-2);
    color: var(--primary);
}

.folder-link.is-active {
    background: var(--primary-soft);
    border-color: rgba(99, 102, 241, 0.4);
    color: var(--primary);
}

.thumb-mini {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--admin-surface-2);
    color: var(--admin-muted);
}

.thumb-mini img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.media-select-all-wrap {
    padding: 6px 10px;
    border-radius: 10px;
    border: 1px solid var(--admin-border);
    background: var(--admin-surface-2);
}

.media-library-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
}

.media-card {
    border: 1px solid var(--admin-border);
    border-radius: 16px;
    overflow: hidden;
    background: var(--admin-surface);
    display: flex;
    flex-direction: column;
}

.media-card.is-trashed {
    opacity: 0.86;
}

.media-card-head {
    padding: 10px 10px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
}

.media-card-preview {
    margin: 10px;
    border-radius: 12px;
    border: 1px solid var(--admin-border);
    min-height: 150px;
    background: var(--admin-surface-2);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    color: var(--admin-muted);
}

.media-card-preview img {
    width: 100%;
    height: 150px;
    object-fit: cover;
}

.media-card-preview i {
    font-size: 2rem;
}

.media-card-body {
    padding: 0 12px 12px;
    display: grid;
    gap: 8px;
}

.media-card-name {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    word-break: break-word;
}

.media-card-mime {
    margin: 0;
    color: var(--admin-muted);
    font-size: 0.78rem;
    word-break: break-all;
}

.media-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.media-meta-pill {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 999px;
    background: var(--admin-surface-2);
    color: var(--admin-muted);
}

.media-card-actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
}

.media-card-actions form {
    margin: 0;
}

.media-empty-state {
    grid-column: 1 / -1;
    border: 1px dashed var(--admin-border-strong);
    border-radius: 16px;
    padding: 60px 20px;
    text-align: center;
    color: var(--admin-muted);
}

.media-empty-state i {
    font-size: 2rem;
    display: block;
    margin-bottom: 10px;
    opacity: 0.5;
}

@media (max-width: 767.98px) {
    .media-library-grid {
        grid-template-columns: 1fr;
    }

    .media-card-actions .btn,
    .media-card-actions form,
    .media-card-actions form .btn {
        width: 100%;
    }
}
</style>
@endpush

@push('scripts')
<script>
document.addEventListener('DOMContentLoaded', () => {
    const selectAll = document.getElementById('mediaSelectAll');
    const checks = Array.from(document.querySelectorAll('.media-checkbox'));
    const bulkApplyBtn = document.getElementById('bulkApplyBtn');
    const bulkAction = document.getElementById('bulkAction');
    const bulkFolder = document.getElementById('bulkFolderSelect');

    const updateBulkButtonState = () => {
        bulkApplyBtn.disabled = checks.every((checkbox) => !checkbox.checked);
    };

    const syncTargetFolderState = () => {
        const isMove = bulkAction.value === 'move';
        bulkFolder.disabled = !isMove;
        if (!isMove) {
            bulkFolder.value = '';
        }
    };

    if (selectAll) {
        selectAll.addEventListener('change', function () {
            checks.forEach((checkbox) => {
                checkbox.checked = this.checked;
            });
            updateBulkButtonState();
        });
    }

    checks.forEach((checkbox) => {
        checkbox.addEventListener('change', updateBulkButtonState);
    });

    bulkAction.addEventListener('change', syncTargetFolderState);
    updateBulkButtonState();
    syncTargetFolderState();
});
</script>
@endpush
